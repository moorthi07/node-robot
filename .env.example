# ── node-robot (RRCA runtime) configuration ──────────────────────────────────
# Copy to .env. Nothing here is secret in the reference build.

# Port for the Node-RED editor (/admin), flow HTTP endpoints (/flow), and the
# status API (/api/status).
PORT=1880

# The robot's RRCF declaration. Swap this to run the RRCA for a different robot;
# the runtime rejects a declaration with no telemetry endpoint at load time.
RRCF_FILE=rrcf/sample-robot.rrcf

# Deployed robots can run with NO editor: author flows on a dev box, ship
# flows.json, set this true in the field. The RRCF nodes and the safety envelope
# behave identically with the editor off.
DISABLE_EDITOR=false

# Node-RED console log level: fatal | error | warn | info | debug | trace
NODE_RED_LOG_LEVEL=info

# LeRobot backend (leLab) default URL — used by the embedded UI panel at
# /lerobot.html and as the default for lerobot-config nodes. Point at a local
# sidecar for record/teleop, or a GPU box for training. Needs leLab running:
#   git clone https://github.com/huggingface/leLab && cd leLab && pip install -e . && lelab
LEROBOT_URL=http://localhost:8000
