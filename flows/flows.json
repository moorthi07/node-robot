[
  {
    "id": "rrca-tab",
    "type": "tab",
    "label": "node-robot RRCA",
    "disabled": false,
    "info": "RRCA reference flow.\n\nOperator path:  command in -> rrcf validate -> rrcf adapter -> endpoint\nSafety path:    estop / release -> rrcf ops\nState path:     telemetry -> rrcf ops (stamps estop_state + health) -> out\n\nThe safety envelope (watchdog + e-stop + speed clamp) is NOT a node in this\nflow. It lives in the runtime (lib/safetyEnvelope.js), is constructed in\nindex.js before the flow starts, and rrcf-adapter dispatches only through it.\nDeleting nodes here cannot disable it."
  },

  {
    "id": "in-cmd",
    "type": "inject",
    "z": "rrca-tab",
    "name": "sample drive command",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"rrcf\":\"1.0\",\"category\":\"wheeled\",\"ly\":0.6,\"rx\":-0.2,\"speed\":0.8,\"mode\":\"drive\",\"estop\":false,\"input\":\"inject\"}",
    "payloadType": "json",
    "x": 180,
    "y": 100,
    "wires": [["node-validate"]]
  },
  {
    "id": "node-validate",
    "type": "rrcf-cmd",
    "z": "rrca-tab",
    "name": "",
    "x": 410,
    "y": 100,
    "wires": [["node-adapter"], ["debug-warn"]]
  },
  {
    "id": "node-adapter",
    "type": "rrcf-adapter",
    "z": "rrca-tab",
    "name": "",
    "adapter": "log",
    "x": 610,
    "y": 100,
    "wires": [["debug-sent"], ["debug-blocked"]]
  },
  {
    "id": "debug-sent",
    "type": "debug",
    "z": "rrca-tab",
    "name": "sent",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 810,
    "y": 80,
    "wires": []
  },
  {
    "id": "debug-blocked",
    "type": "debug",
    "z": "rrca-tab",
    "name": "blocked",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 820,
    "y": 120,
    "wires": []
  },
  {
    "id": "debug-warn",
    "type": "debug",
    "z": "rrca-tab",
    "name": "validation warnings",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 640,
    "y": 160,
    "wires": []
  },

  {
    "id": "in-estop",
    "type": "inject",
    "z": "rrca-tab",
    "name": "ESTOP",
    "props": [{ "p": "payload" }, { "p": "topic", "v": "estop", "vt": "str" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "estop",
    "payload": "{\"reason\":\"operator button\"}",
    "payloadType": "json",
    "x": 180,
    "y": 240,
    "wires": [["node-ops"]]
  },
  {
    "id": "in-release",
    "type": "inject",
    "z": "rrca-tab",
    "name": "Release e-stop",
    "props": [{ "p": "payload" }, { "p": "topic", "v": "release", "vt": "str" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "release",
    "payload": "",
    "payloadType": "date",
    "x": 190,
    "y": 300,
    "wires": [["node-ops"]]
  },
  {
    "id": "in-status",
    "type": "inject",
    "z": "rrca-tab",
    "name": "Safety status (every 5s)",
    "props": [{ "p": "payload" }],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 200,
    "y": 360,
    "wires": [["node-ops"]]
  },
  {
    "id": "node-ops",
    "type": "rrcf-ops",
